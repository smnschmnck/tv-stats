---
import { Clapperboard } from "@lucide/astro";
import type { Movie } from "../types/tmdbApi/movie";
import { getLocaleLink } from "../i18n/utils";
import { getRatingClassName } from "../pages/[locale]/show/_utils/getRatingClassName";
import { getRatings } from "../db/ratingsRedis";
import { getImdbId } from "../utils/tmdb/imdbId";

interface Props {
  movie: Movie;
}

const { movie } = Astro.props;
const url = getLocaleLink(Astro.currentLocale, `/movie/${movie.id}`);
const imdbId = await getImdbId(String(movie.id), "movie");
const ratings = await getRatings(imdbId);
const hasRating = !!ratings?.averageRating;
const ratingClassName = hasRating
  ? getRatingClassName(ratings.averageRating)
  : "bg-zinc-700";
---

<div class="h-76 overflow-visible">
  <a
    href={url}
    target="_blank"
    rel="noreferrer"
    class="group flex h-fit flex-col items-center gap-2"
  >
    <div class="relative">
      {
        movie.poster_path ? (
          <img
            class="w-32 rounded-xl transition group-hover:opacity-60"
            src={`https://image.tmdb.org/t/p/w500/${movie.poster_path}`}
            alt={`${movie.title} poster`}
          />
        ) : (
          <div class="flex aspect-2/3 w-32 items-center justify-center rounded-xl bg-zinc-700 text-zinc-500 transition group-hover:bg-zinc-600 dark:bg-zinc-800 dark:text-zinc-600 dark:group-hover:bg-zinc-700">
            <Clapperboard />
          </div>
        )
      }
      {
        hasRating && (
          <span
            class:list={[
              "absolute -top-1.5 -right-1.5 rounded-md px-2 py-1 text-xs font-semibold text-white shadow-sm ring-1 ring-black/10 backdrop-blur-sm",
              ratingClassName,
            ]}
          >
            {ratings.averageRating}
          </span>
        )
      }
    </div>
    <p class="line-clamp-3 w-32 text-center font-medium">{movie.title}</p>
  </a>
</div>
