---
import { Check, Search } from "@lucide/astro";
import { getLocaleLink } from "../i18n/utils";

const { t } = Astro.locals;

const query = Astro.url.searchParams.get("q");
const includeMovies = Astro.url.searchParams.get("include-movies") === "on";

const searchUrl = getLocaleLink(Astro.currentLocale, "/search");
---

<form action={searchUrl}>
  <div
    class="flex h-11 w-full items-center justify-between rounded-full border border-zinc-200 bg-white px-1.5 ring-blue-500 focus-within:ring-2 dark:border-zinc-700 dark:bg-zinc-800"
  >
    <div class="flex h-full w-full items-center gap-2 px-3">
      <input
        name="q"
        autocomplete="off"
        class="h-full w-full bg-transparent font-medium outline-none placeholder:text-zinc-500 dark:placeholder:text-zinc-400"
        placeholder={t("components.searchBarSmall.placeholder")}
        value={query}
      />
    </div>
    <label
      class="group mr-1 inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-full bg-zinc-50 px-2 text-zinc-600 transition hover:bg-zinc-100 has-[:checked]:bg-zinc-100 has-[:checked]:text-blue-700 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500/40 has-[:focus-visible]:ring-offset-2 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 dark:has-[:checked]:bg-zinc-700 dark:has-[:checked]:text-blue-300"
    >
    <input
      type="checkbox"
      name="include-movies"
      class="peer sr-only"
      checked={includeMovies}
    />
    <span
      aria-hidden="true"
      class="flex size-4 items-center justify-center rounded-full border border-zinc-300 bg-zinc-50 text-white transition group-hover:border-zinc-400 peer-checked:border-blue-600 peer-checked:bg-blue-600 dark:border-zinc-600 dark:bg-zinc-800 dark:group-hover:border-zinc-400 dark:peer-checked:border-blue-500 dark:peer-checked:bg-blue-500"
    >
      <Check
        size={10}
        stroke-width={3}
        class="scale-75 opacity-0 transition group-has-[:checked]:scale-100 group-has-[:checked]:opacity-100"
      />
    </span>
      <span class="text-xs font-medium">Movies</span>
    </label>
    <button
      type="submit"
      class="flex max-h-8 min-h-8 max-w-8 min-w-8 items-center justify-center rounded-full bg-black font-medium text-white transition hover:bg-zinc-700 dark:bg-white dark:text-black dark:hover:bg-zinc-200"
    >
      <Search size={16} stroke-width={2} />
    </button>
  </div>
</form>
