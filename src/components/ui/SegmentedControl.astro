---
interface Props {
  field: string;
  options: { label: string; value: string; defaultChecked?: boolean }[];
  size?: "default" | "compact";
}

const { options, field, size = "default" } = Astro.props;
const isCompact = size === "compact";
const containerPadding = isCompact ? "px-2 py-1" : "px-3 py-2";
const labelPadding = isCompact ? "px-3 py-1.5" : "px-4 py-2";
const indicatorInsetX = isCompact ? "0.5rem" : "0.75rem";
const indicatorInsetY = isCompact ? "0.25rem" : "0.5rem";

const indicatorStyles = `
  .segmented-control {
    grid-template-columns: repeat(var(--segment-count), minmax(0, 1fr));
  }

  .segmented-control__indicator {
    width: calc(
      (100% - (2 * var(--segment-indicator-inset-x))) / var(--segment-count)
    );
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .segmented-control__indicator {
      transition: none;
    }
  }

${options
  .map(
    (_, index) => `
      .segmented-control:has(.segmented-control__option:nth-of-type(${index + 1}) > input:checked) .segmented-control__indicator {
        transform: translateX(${index * 100}%);
      }
    `,
  )
  .join("\n")}
`;
---

<fieldset
  class:list={[
    "segmented-control relative grid items-center rounded-full bg-zinc-100 text-sm font-medium text-zinc-600 transition-colors dark:bg-zinc-800 dark:text-zinc-300",
    containerPadding,
  ]}
  style={`--segment-count: ${options.length}; --segment-indicator-inset-x: ${indicatorInsetX}`}
>
  {
    options.map(({ label, value, defaultChecked }) => (
      <div class="segmented-control__option group relative z-10">
        <input
          type="radio"
          name={field}
          value={value}
          id={`${field}-${value}`}
          class="sr-only"
          checked={!!defaultChecked}
        />
        <label
          class:list={[
            "block cursor-pointer rounded-full text-center transition-colors group-has-checked:text-zinc-900 group-has-focus-visible:ring-2 group-has-focus-visible:ring-blue-500/60 hover:text-zinc-900 group-has-checked:hover:text-zinc-900 dark:group-has-checked:text-white dark:hover:text-white dark:group-has-checked:hover:text-white",
            labelPadding,
          ]}
          for={`${field}-${value}`}
        >
          {label}
        </label>
      </div>
    ))
  }
  <span
    class="segmented-control__indicator pointer-events-none absolute rounded-full bg-white dark:bg-zinc-700"
    style={`inset-block: ${indicatorInsetY}; inset-inline-start: ${indicatorInsetX}`}
    aria-hidden="true"></span>
</fieldset>

<style is:inline set:html={indicatorStyles}></style>
