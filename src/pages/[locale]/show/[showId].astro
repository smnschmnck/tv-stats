---
import LoadingFallback from "../../../components/ui/LoadingFallback.astro";
import Spinner from "../../../components/ui/Spinner.astro";
import { cached, DAY } from "../../../db/cachingRedis";
import { getRatings } from "../../../db/ratingsRedis";
import { fallbackLanguage } from "../../../i18n/constants";
import BaseSearchLayout from "../../../layouts/BaseSearchLayout.astro";
import type { TVShowDetails } from "../../../types/tmdbApi/tvShowDetails";
import { getImdbId } from "../../../utils/tmdb/imdbId";
import { tmdbFetch } from "../../../utils/tmdbFetch";
import { EpisodeInfo } from "./_components/EpisodeInfo";
import Ratings from "./_components/Ratings.astro";
import ShowDetails from "./_components/ShowDetails.astro";

const { t } = Astro.locals;
const locale = Astro.currentLocale ?? fallbackLanguage;

const { showId } = Astro.params;

const imdbId = await getImdbId(showId);

const ratings = await getRatings(imdbId);

const getShowDetails = async () => {
  try {
    const showDetails = await cached({
      cacheKey: `tmdb:show:${showId}:${Astro.currentLocale ?? "default"}`,
      ttl: DAY,
      queryFn: async () => {
        const res = await tmdbFetch(`/tv/${showId}`, {
          locale: Astro.currentLocale,
        });

        if (!res.ok) {
          return;
        }

        return (await res.json()) as TVShowDetails;
      },
    });

    if (!showDetails) {
      return { error: t("show.notFound"), showDetails: undefined };
    }

    return { error: undefined, showDetails };
  } catch (e) {
    return { error: t("show.notFound"), showDetails: undefined };
  }
};

const { error, showDetails } = await getShowDetails();
---

<BaseSearchLayout
  ogImage={`${Astro.url.host}/${Astro.currentLocale}/show/og/${showId}.png`}
  ogTitle={showDetails?.name}
  ogType="video.tv_show"
  ogUrl={Astro.url.toString()}
>
  {!showId && <p>{t("show.notFound")}</p>}
  {
    !!showId && (
      <div class="flex w-full flex-col gap-4 px-8 pb-8 md:flex-row md:px-12">
        <div class="flex h-fit min-h-128 w-full min-w-72 flex-col gap-2 rounded-xl border border-zinc-100 bg-zinc-50 p-4 md:w-80 md:min-w-80 dark:border-zinc-800 dark:bg-zinc-800/50">
          <ShowDetails showId={showId} imdbId={imdbId} ratings={ratings} />
        </div>
        <div class="flex w-full flex-col gap-4 overflow-x-auto rounded-xl border border-zinc-100 bg-zinc-50 p-4 md:w-fit md:p-8 dark:border-zinc-800 dark:bg-zinc-800/50">
          <h2 class="text-lg font-bold">{t("show.ratings.header")}</h2>
          <LoadingFallback>
            <div
              class="flex h-full w-64 max-w-full items-center justify-center"
              slot="fallback"
            >
              <Spinner />
            </div>
            {!imdbId && <p>{t("show.ratings.notFound")}</p>}
            {!!imdbId && <Ratings ratings={ratings} slot="content" />}
          </LoadingFallback>
        </div>
      </div>
    )
  }
  <EpisodeInfo client:load locale={locale} />
</BaseSearchLayout>
