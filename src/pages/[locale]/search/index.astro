---
import TvShowLink from "../../../components/TvShowLink.astro";
import MovieLink from "../../../components/MovieLink.astro";
import Pagination from "../../../components/ui/Pagination.astro";
import BaseSearchLayout from "../../../layouts/BaseSearchLayout.astro";
import type { Movie, MovieListResponse } from "../../../types/tmdbApi/movie";
import type { TvShowListResponse } from "../../../types/tmdbApi/tvShow";
import type { TvShow } from "../../../types/tmdbApi/tvShow";
import { tmdbFetch } from "../../../utils/tmdbFetch";

const { t } = Astro.locals;

const url = Astro.url;
const query = url.searchParams.get("q");
const currentPage = url.searchParams.get("page") ?? "1";
const includeMovies = url.searchParams.get("include-movies") === "on";

type SearchResult =
  | { mediaType: "tv"; item: TvShow }
  | { mediaType: "movie"; item: Movie };

type SearchResults = {
  results: SearchResult[];
  total_pages: number;
  total_results: number;
};

if (Number(currentPage) < 1) {
  const page1 = new URL(url);
  page1.searchParams.delete("page");
  return Astro.redirect(page1.toString());
}

const getSearchResults = async () => {
  if (!query) {
    return { error: t("search.noQueryProvided"), results: undefined } as const;
  } else {
    try {
      const searchQuery = encodeURIComponent(query);
      const response = await tmdbFetch(
        `/search/${includeMovies ? "movie" : "tv"}?query=${searchQuery}&include_adult=true`,
        { locale: Astro.currentLocale, page: currentPage },
      );

      if (!response.ok) {
        return {
          error: t("common.somethingWentWrong"),
          results: undefined,
        } as const;
      } else {
        const searchResponse = (await response.json()) as
          | TvShowListResponse
          | MovieListResponse;
        const results: SearchResults = includeMovies
          ? {
              results: (searchResponse as MovieListResponse).results.map(
                (item) => ({ mediaType: "movie" as const, item }),
              ),
              total_pages: searchResponse.total_pages,
              total_results: searchResponse.total_results,
            }
          : {
              results: (searchResponse as TvShowListResponse).results.map(
                (item) => ({ mediaType: "tv" as const, item }),
              ),
              total_pages: searchResponse.total_pages,
              total_results: searchResponse.total_results,
            };
        return { error: undefined, results };
      }
    } catch (e) {
      return {
        error: t("common.somethingWentWrong"),
        results: undefined,
      } as const;
    }
  }
};

const { results, error } = await getSearchResults();
---

<BaseSearchLayout>
  <div class="pb-24">
    <div class="h-full w-full px-8 pt-4 md:px-16">
      {
        !!error && (
          <div class="flex h-full w-full items-center justify-center">
            <h1 class="text-2xl font-bold">{error}</h1>
          </div>
        )
      }{
        !error && (
          <div class="flex flex-col gap-8">
            <div class="flex w-full flex-wrap items-center justify-between gap-3">
              <h1 class="text-xl font-bold">
                {t("search.resultsFor", { query })}
              </h1>
              <p class="font-medium">
                {t("search.showsFound", { count: results?.total_results })}
              </p>
            </div>
            <div class="grid w-full grid-cols-[repeat(auto-fill,8rem)] justify-between gap-4">
              {results!.total_results <= 0 ? (
                <p class="col-span-full pt-32 text-center text-xl font-bold">
                  {t("search.noResults", { query })}
                </p>
              ) : (
                results!.results.map((result) =>
                  result.mediaType === "tv" ? (
                    <TvShowLink show={result.item} />
                  ) : (
                    <MovieLink movie={result.item} />
                  ),
                )
              )}
            </div>
          </div>
        )
      }
    </div>
    <div class="sm:hidden">
      <Pagination
        totalPages={results?.total_pages}
        currentPage={Number(currentPage)}
        windowSize={5}
      />
    </div>
    <div class="hidden sm:block">
      <Pagination
        totalPages={results?.total_pages}
        currentPage={Number(currentPage)}
        windowSize={10}
      />
    </div>
  </div>
</BaseSearchLayout>
